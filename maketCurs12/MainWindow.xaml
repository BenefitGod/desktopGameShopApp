<Window x:Class="maketCurs12.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:maketCurs12"
        xmlns:viewModels="clr-namespace:maketCurs12.ViewModels"
        xmlns:models="clr-namespace:maketCurs12.Models"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        WindowState="Maximized"
        Background="LightGray"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanMinimize"
        Loaded="Window_Loaded">

    <Window.DataContext>
        <viewModels:GamesViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Эффект тени для карточек -->
        <DropShadowEffect x:Key="DropShadowEffect" 
                          BlurRadius="10" 
                          Opacity="0.3" 
                          ShadowDepth="3"
                          Color="Black"/>

        <!-- Стиль для кнопок -->
        <!-- Вместо <Style TargetType="Button"> используйте стиль с ключом -->
        <Style x:Key="TransparentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center" 
                                VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для обычной кнопки с рамкой -->
        <Style x:Key="NormalButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#1976D2"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Анимация для плавного появления/исчезновения -->
        <Storyboard x:Key="FadeInStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.3"/>
        </Storyboard>

        <Storyboard x:Key="FadeOutStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:0.2"/>
        </Storyboard>

        <!-- Конвертер для позиции ползунка -->
        <local:BoolToColumnConverter x:Key="BoolToColumnConverter"/>

        <!-- Стиль для ToggleButton (ползунок) -->
        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Width" Value="80"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border Background="#E0E0E0"
                                BorderBrush="#CCCCCC"
                                BorderThickness="1"
                                CornerRadius="15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Кружок-переключатель -->
                                <Border x:Name="SwitchButton"
                                        Width="26"
                                        Height="26"
                                        CornerRadius="13"
                                        Background="White"
                                        Margin="2"
                                        HorizontalAlignment="Left"
                                        Grid.Column="0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="3" Opacity="0.2" ShadowDepth="1"/>
                                    </Border.Effect>
                                </Border>

                                <!-- Текст статуса -->
                                <TextBlock x:Name="StatusText"
                                           Text="Выкл"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Grid.Column="1"
                                           Margin="0,0,5,0"
                                           Foreground="#9E9E9E"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchButton" Property="Grid.Column" Value="1"/>
                                <Setter TargetName="SwitchButton" Property="Margin" Value="0,2,2,2"/>
                                <Setter TargetName="SwitchButton" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="StatusText" Property="Text" Value="Вкл"/>
                                <Setter TargetName="StatusText" Property="Foreground" Value="#4CAF50"/>
                                <Setter TargetName="StatusText" Property="Grid.Column" Value="0"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="SwitchButton" Property="Grid.Column" Value="0"/>
                                <Setter TargetName="SwitchButton" Property="Margin" Value="2,2,0,2"/>
                                <Setter TargetName="SwitchButton" Property="HorizontalAlignment" Value="Left"/>
                                <Setter TargetName="StatusText" Property="Text" Value="Выкл"/>
                                <Setter TargetName="StatusText" Property="Foreground" Value="#9E9E9E"/>
                                <Setter TargetName="StatusText" Property="Grid.Column" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Шаблон карточки игры -->
        <DataTemplate x:Key="GameTemplate" DataType="models:Game">
            <Button Background="Transparent" 
                    BorderThickness="0"
                    Tag="{Binding Name}"
                    Style="{StaticResource TransparentButtonStyle}"
                    Click="GameCard_Click">
                <Border Width="200"
                        Height="280"
                        CornerRadius="60"
                        Margin="0,0,15,15"
                        Background="Transparent"
                        BorderBrush="#CCCCCC"
                        BorderThickness="1"
                        HorizontalAlignment="Left"
                        Effect="{StaticResource DropShadowEffect}">
                    <Border.Clip>
                        <RectangleGeometry Rect="0,0,200,280" RadiusX="60" RadiusY="60"/>
                    </Border.Clip>

                    <Grid>
                        <Image Source="{Binding ImagePath}"
                               Stretch="UniformToFill"
                               StretchDirection="Both">
                            <Image.Effect>
                                <BlurEffect Radius="5"/>
                            </Image.Effect>
                        </Image>

                        <Rectangle Fill="#80000000"/>

                        <Rectangle VerticalAlignment="Bottom" Height="100">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="Transparent" Offset="0"/>
                                    <GradientStop Color="#CC000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>

                        <StackPanel VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Margin="10">

                            <Image Source="{Binding IconPath}" 
                                   Width="60" 
                                   Height="60"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,15"
                                   Stretch="UniformToFill"/>

                            <TextBlock Text="{Binding Name}" 
                                       FontSize="22"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="White"
                                       Margin="0,0,0,10"/>

                            <TextBlock Text="{Binding Genre}" 
                                       FontSize="14"
                                       HorizontalAlignment="Center"
                                       Foreground="#DDDDDD"
                                       Margin="0,0,0,15"/>

                            <!-- Статус игры (зеленый/красный) -->
                            <Border Background="{Binding StatusColor}"
                                    CornerRadius="20"
                                    Padding="15,8"
                                    HorizontalAlignment="Center"
                                    BorderBrush="White"
                                    BorderThickness="1">
                                <TextBlock Text="{Binding Status}" 
                                           Foreground="White" 
                                           FontSize="12"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Button>
        </DataTemplate>

        <!-- Шаблон карточки мода -->
        <!-- Шаблон карточки мода (измененный - добавлена кнопка удаления) -->
        <DataTemplate x:Key="ModTemplate" DataType="models:Mod">
            <Border Margin="0,0,0,10"
            CornerRadius="10"
            Background="White"
            BorderBrush="#CCCCCC"
            BorderThickness="1"
            Padding="15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Иконка мода -->
                    <Border Grid.Column="0"
                    Width="50"
                    Height="50"
                    CornerRadius="8"
                    Background="#F0F0F0"
                    Margin="0,0,15,0">
                        <Image Source="{Binding IconPath}"
                       Width="40"
                       Height="40"
                       Stretch="UniformToFill"/>
                    </Border>

                    <!-- Информация о моде -->
                    <StackPanel Grid.Column="1"
                        VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" 
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding Description}" 
                           FontSize="12"
                           Foreground="Gray"
                           TextWrapping="Wrap"/>
                        <!-- Отображение тегов -->
                        <ItemsControl ItemsSource="{Binding Tags}"
                              Margin="0,5,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#E0E0E0"
                                    CornerRadius="10"
                                    Padding="8,3"
                                    Margin="0,0,5,0">
                                        <TextBlock Text="{Binding}"
                                           FontSize="10"
                                           Foreground="#333333"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Ползунок включения/выключения -->
                    <CheckBox Grid.Column="2"
                      Style="{StaticResource ToggleSwitchStyle}"
                      IsChecked="{Binding IsEnabled}"
                      Tag="{Binding Name}"
                      Checked="ModToggle_Changed"
                      Unchecked="ModToggle_Changed"
                      VerticalAlignment="Center"
                      Margin="0,0,10,0"/>

                    <!-- Кнопка удаления -->
                    <Button Grid.Column="3"
                    Width="30"
                    Height="30"
                    Style="{StaticResource TransparentButtonStyle}"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    Tag="{Binding}"
                    Click="DeleteMod_Click"
                    ToolTip="Удалить мод">
                        <TextBlock Text="🗑️" 
                           FontSize="18" 
                           Foreground="#FF5722"/>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Стиль для TextBox с placeholder -->
        <Style x:Key="PlaceholderTextBox" TargetType="TextBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                                     Background="{TemplateBinding Background}"
                                     Padding="{TemplateBinding Padding}"
                                     VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                     BorderThickness="{TemplateBinding BorderThickness}"
                                     FontSize="{TemplateBinding FontSize}"/>
                            <TextBlock Text="{TemplateBinding Tag}" 
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"
                                       Foreground="Gray"
                                       FontStyle="Italic"
                                       FontSize="{TemplateBinding FontSize}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding SearchText, RelativeSource={RelativeSource AncestorType=TextBox}}" Value=""/>
                                                    <Condition Binding="{Binding IsFocused, RelativeSource={RelativeSource AncestorType=TextBox}}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="100"/>
                <RowDefinition Height="100"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============= ГЛАВНАЯ СТРАНИЦА ============= -->
            <Grid x:Name="MainPage" Grid.RowSpan="6" Grid.ColumnSpan="6" Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="100"/>
                    <RowDefinition Height="100"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Белая полоска разделитель -->
                <Rectangle Grid.Row="0" 
                           Grid.Column="1"
                           Grid.RowSpan="5"
                           Width="25" 
                           HorizontalAlignment="Left"
                           VerticalAlignment="Stretch"
                           Fill="White"
                           Opacity="0.9"/>

                <!-- Заголовок -->
                <TextBlock Text="Библиотека игр" 
                           Grid.Row="0" Grid.Column="0" 
                           Grid.ColumnSpan="4"
                           VerticalAlignment="Bottom"
                           Margin="185,0,0,0"
                           FontSize="48"
                           FontWeight="Bold"
                           FontFamily="Segoe UI"
                           Foreground="Black"/>

                <!-- Поисковая строка -->
                <Border Grid.Row="1" Grid.Column="0"
                        Grid.ColumnSpan="4"
                        Width="550"
                        Height="40"
                        CornerRadius="20"
                        Background="#F0F0F0"
                        BorderBrush="#CCCCCC"
                        BorderThickness="1"
                        Margin="185,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Style="{StaticResource PlaceholderTextBox}"
                                 Tag="Найдите игру..."
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="15,0,8,0"
                                 VerticalAlignment="Center"
                                 VerticalContentAlignment="Center"  
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Height="30"
                                 FontSize="14"/>

                        <!-- Кнопка поиска -->
                        <Button Grid.Column="1"
                                Width="30"
                                Height="30"
                                Style="{StaticResource TransparentButtonStyle}"
                                Margin="0,0,5,0"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Command="{Binding SearchCommand}">
                            <TextBlock Text="🔍" Foreground="Black" FontSize="18"/>
                        </Button>

                        <!-- Кнопка очистки поиска -->
                        <Button Grid.Column="2"
                                Width="30"
                                Height="30"
                                Margin="0,0,8,0"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Command="{Binding ClearSearchCommand}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="0.7"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="✕" Foreground="Gray" FontSize="18" FontWeight="Bold"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Полоска -->
                <Rectangle Grid.Row="1" 
                           Grid.Column="1"
                           Grid.ColumnSpan="5"
                           Height="2"
                           Fill="Black"
                           Margin="25,80,0,0"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Top"
                           Opacity="0.8"/>

                <!-- ПЕРВЫЙ СПИСОК: Мои игры -->
                <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="5"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Top"
                      Margin="35,0,0,0">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto" x:Name="FirstPanelRow"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок секции с кнопкой добавления -->
                    <Border Grid.Row="0"
                            Background="#F5F5F5"
                            CornerRadius="10"
                            Padding="15,10"
                            BorderBrush="#CCCCCC"
                            BorderThickness="1"
                            Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" 
                                       Text="🎮" 
                                       FontSize="24"
                                       Margin="0,0,10,0"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="1" 
                                       Text="Мои игры" 
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>

                            <!-- Кнопка добавления игры -->
                            <Button Grid.Column="2"
                                    Width="30"
                                    Height="30"
                                    Style="{StaticResource TransparentButtonStyle}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="AddGameButton_Click"
                                    ToolTip="Добавить игру">
                                <TextBlock Text="+" 
                                           FontSize="24" 
                                           Foreground="#4CAF50"
                                           FontWeight="Bold"/>
                            </Button>

                            <Button Grid.Column="3"
                                    Width="30"
                                    Height="30"
                                    Style="{StaticResource TransparentButtonStyle}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Command="{Binding ToggleFirstPanelCommand}">
                                <TextBlock Text="{Binding FirstPanelIcon}" 
                                           FontSize="16" 
                                           Foreground="Gray"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Контент с играми -->
                    <StackPanel Grid.Row="1" 
                                Name="FirstPanelContent"
                                Margin="0,10,0,0"
                                Visibility="{Binding FirstPanelVisibility}">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <Trigger Property="Visibility" Value="Visible">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard Storyboard="{StaticResource FadeInStoryboard}"/>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard Storyboard="{StaticResource FadeOutStoryboard}"/>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <ItemsControl x:Name="MyGamesItemsControl"
                                      ItemsSource="{Binding MyGames}"
                                      ItemTemplate="{StaticResource GameTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Grid>

                <!-- Отступ -->
                <Grid Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="5"/>

                <!-- ВТОРОЙ СПИСОК: Не добавленные игры -->
                <Grid Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="5"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Top"
                      Margin="35,0,0,0">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto" x:Name="SecondPanelRow"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок секции -->
                    <Border Grid.Row="0"
                            Background="#F5F5F5"
                            CornerRadius="10"
                            Padding="15,10"
                            BorderBrush="#CCCCCC"
                            BorderThickness="1"
                            Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" 
                                       Text="📥" 
                                       FontSize="24"
                                       Margin="0,0,10,0"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="1" 
                                       Text="Не добавленные игры" 
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>

                            <Button Grid.Column="2"
                                    Width="30"
                                    Height="30"
                                    Style="{StaticResource TransparentButtonStyle}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Command="{Binding ToggleSecondPanelCommand}">
                                <TextBlock Text="{Binding SecondPanelIcon}" 
                                           FontSize="16" 
                                           Foreground="Gray"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Контент с играми -->
                    <StackPanel Grid.Row="1" 
                                Name="SecondPanelContent"
                                Margin="0,10,0,0"
                                Visibility="{Binding SecondPanelVisibility}">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <Trigger Property="Visibility" Value="Visible">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard Storyboard="{StaticResource FadeInStoryboard}"/>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard Storyboard="{StaticResource FadeOutStoryboard}"/>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <ItemsControl ItemsSource="{Binding NotAddedGames}"
                                      ItemTemplate="{StaticResource GameTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ============= СТРАНИЦА ДОБАВЛЕНИЯ ИГРЫ ============= -->
            <Grid x:Name="AddGamePage" 
                  Grid.RowSpan="6" 
                  Grid.ColumnSpan="6"
                  Background="LightGray"
                  Visibility="Collapsed">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Верхняя панель с кнопкой назад -->
                <Border Grid.Row="0"
                        Background="#F5F5F5"
                        CornerRadius="10"
                        Padding="15,10"
                        BorderBrush="#CCCCCC"
                        BorderThickness="1"
                        Margin="15,20,15,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Кнопка назад -->
                        <Button Grid.Column="0"
                                Width="40"
                                Height="40"
                                Background="Transparent"
                                BorderThickness="0"
                                Style="{StaticResource TransparentButtonStyle}"
                                Cursor="Hand"
                                Click="CancelAddGame_Click">
                            <TextBlock Text="←" FontSize="30" Foreground="Black"/>
                        </Button>

                        <!-- Название страницы -->
                        <TextBlock Grid.Column="1" 
                                   Text="Добавление новой игры"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Форма добавления игры -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="15,0,15,15">

                    <Border Background="White"
                            CornerRadius="10"
                            Padding="25"
                            BorderBrush="#CCCCCC"
                            BorderThickness="1">

                        <StackPanel>
                            <!-- Заголовок для фото -->
                            <TextBlock Text="Изображение игры:" 
                                       FontSize="16" 
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10"
                                       HorizontalAlignment="Center"/>

                            <!-- Предпросмотр фото с текстовой подсказкой -->
                            <Border x:Name="GamePhotoPreview"
                                    Width="220"
                                    Height="220"
                                    CornerRadius="20"
                                    Background="#F0F0F0"
                                    BorderBrush="#2196F3"
                                    BorderThickness="2"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,15"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="SelectGamePhoto_Click">
                                <Grid>
                                    <Image x:Name="GamePhotoImage"
                                           Stretch="UniformToFill"
                                           Margin="0"
                                           Visibility="Collapsed"/>

                                    <TextBlock x:Name="PhotoText"
                                               Text="Добавить фото"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="#666666"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"/>
                                </Grid>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=GamePhotoImage, Path=Source}" Value="{x:Null}">
                                                <Setter Property="Background" Value="#F0F0F0"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ElementName=GamePhotoImage, Path=Source}" Value="{x:Null}">
                                                <Setter Property="BorderBrush" Value="#2196F3"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <!-- Поле для названия -->
                            <TextBlock Text="Название игры:" 
                                       FontSize="14" 
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,5"/>
                            <TextBox x:Name="GameNameInput"
                                     Height="40"
                                     Padding="10"
                                     Margin="0,0,0,15"
                                     FontSize="14"
                                     BorderBrush="#CCCCCC"
                                     BorderThickness="1"/>

                            <!-- Поле для жанра -->
                            <TextBlock Text="Жанр:" 
                                       FontSize="14" 
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,5"/>
                            <TextBox x:Name="GameGenreInput"
                                     Height="40"
                                     Padding="10"
                                     Margin="0,0,0,15"
                                     FontSize="14"
                                     BorderBrush="#CCCCCC"
                                     BorderThickness="1"/>

                            <!-- Поле для описания -->
                            <TextBlock Text="Описание:" 
                                       FontSize="14" 
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,5"/>
                            <TextBox x:Name="GameDescriptionInput"
                                     Height="80"
                                     Padding="10"
                                     Margin="0,0,0,15"
                                     FontSize="14"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     BorderBrush="#CCCCCC"
                                     BorderThickness="1"/>

                            <!-- Поле для пути (просто для макета) -->
                            <TextBlock Text="Путь к игре (для макета):" 
                                       FontSize="14" 
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,5"/>
                            <TextBox x:Name="GamePathInput"
                                     Height="40"
                                     Padding="10"
                                     Margin="0,0,0,25"
                                     FontSize="14"
                                     Text="C:\Games\"
                                     BorderBrush="#CCCCCC"
                                     BorderThickness="1"/>

                            <Button Content="Сохранить игру"
                                    Height="45"
                                    Width="500"
                                    Margin="0,20,0,25"
                                    Style="{StaticResource NormalButtonStyle}"
                                    Background="#4CAF50"
                                    BorderBrush="#388E3C"
                                    Click="SaveNewGame_Click"/>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Grid>

            <!-- ============= СТРАНИЦА МОДОВ ============= -->
            <Grid x:Name="ModsPage" 
                  Grid.RowSpan="6" 
                  Grid.ColumnSpan="6"
                  Background="LightGray"
                  Visibility="Collapsed">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Верхняя панель с кнопкой назад и кнопкой добавления мода -->
                <Border Grid.Row="0"
                        Background="#F5F5F5"
                        CornerRadius="10"
                        Padding="15,10"
                        BorderBrush="#CCCCCC"
                        BorderThickness="1"
                        Margin="15,20,15,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Кнопка назад -->
                        <Button Grid.Column="0"
                                Width="40"
                                Height="40"
                                Background="Transparent"
                                BorderThickness="0"
                                Style="{StaticResource TransparentButtonStyle}"
                                Cursor="Hand"
                                Click="BackToGames_Click">
                            <TextBlock Text="←" FontSize="30" Foreground="Black"/>
                        </Button>

                        <!-- Название страницы -->
                        <TextBlock Grid.Column="1" 
                                   Text="Моды"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <!-- Кнопка добавления мода -->
                        <Button Grid.Column="2"
                                Width="40"
                                Height="40"
                                Background="Transparent"
                                BorderThickness="0"
                                Style="{StaticResource TransparentButtonStyle}"
                                Cursor="Hand"
                                Click="AddModButton_Click"
                                ToolTip="Добавить мод из архива">
                            <TextBlock Text="+" 
                                       FontSize="24" 
                                       Foreground="#4CAF50"
                                       FontWeight="Bold"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Информация об игре -->
                <Border Grid.Row="1"
                        Background="White"
                        CornerRadius="10"
                        Padding="20"
                        BorderBrush="#CCCCCC"
                        BorderThickness="1"
                        Margin="15,0,15,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Картинка игры -->
                        <Border Grid.Column="0"
                                Width="180"
                                Height="180"
                                CornerRadius="20"
                                Background="#F0F0F0"
                                BorderBrush="#CCCCCC"
                                BorderThickness="1">
                            <Image x:Name="SelectedGameImage"
                                   Stretch="UniformToFill"
                                   Margin="0"/>
                        </Border>

                        <!-- Описание игры -->
                        <StackPanel Grid.Column="1"
                                    Margin="20,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="SelectedGameNameText"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Margin="0,0,0,10"/>
                            <TextBlock x:Name="SelectedGameGenreText"
                                       FontSize="18"
                                       Foreground="Gray"
                                       Margin="0,0,0,10"/>
                            <TextBlock x:Name="SelectedGameDescriptionText"
                                       FontSize="14"
                                       Foreground="#666666"
                                       TextWrapping="Wrap"
                                       Text="Здесь будет описание игры и информация о доступных модах."/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Список модов с выпадающим списком -->
                <Grid Grid.Row="2" Margin="15,0,15,15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Выпадающий список категорий -->
                    <ComboBox x:Name="ModCategoryComboBox"
                              Grid.Row="0"
                              Margin="0,0,0,10"
                              Height="35"
                              FontSize="16"
                              SelectionChanged="ModCategory_Changed">
                        <ComboBoxItem Content="Все моды" IsSelected="True"/>
                        <ComboBoxItem Content="Графика"/>
                        <ComboBoxItem Content="Геймплей"/>
                        <ComboBoxItem Content="Оружие"/>
                        <ComboBoxItem Content="Персонажи"/>
                    </ComboBox>

                    <!-- Список модов с прокруткой -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="ModsItemsControl"
                                      ItemTemplate="{StaticResource ModTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- Фоновое изображение слева (для всех страниц) -->
            <Image Grid.Column="0" 
                   Grid.RowSpan="6" 
                   Grid.Row="0" 
                   Source="C:\Users\voido\Downloads\картинка.jpg"  
                   Stretch="UniformToFill"
                   Panel.ZIndex="-1">
                <Image.Effect>
                    <BlurEffect Radius="10"/>
                </Image.Effect>
            </Image>
        </Grid>
    </ScrollViewer>
</Window>